{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Edit(backend/tests/**)",
      "Write(backend/tests/**)",
      "Edit(frontend/src/**/*.test.ts)",
      "Write(frontend/src/**/*.test.ts)",
      "Edit(frontend/src/**/*.test.tsx)",
      "Write(frontend/src/**/*.test.tsx)",
      "Edit(frontend/src/test/**)",
      "Write(frontend/src/test/**)",
      "Edit(.agent-output/**)",
      "Write(.agent-output/**)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npx vitest *)",
      "Bash(npx prettier *)",
      "Bash(node .claude/skills/analyze-changes/scripts/analyze-changes.ts *)",
      "Bash(node .claude/skills/run-tests/scripts/run-tests.ts *)",
      "Bash(node .claude/skills/report-results/scripts/render-report.ts *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git checkout -- *)",
      "Bash(ls *)",
      "Bash(cd backend)",
      "Bash(cd frontend)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(grep *)",
      "Bash(wc *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(**/package.json)",
      "Edit(**/package-lock.json)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git config *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx -y *)"
    ]
  }
}
